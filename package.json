{
  "name": "git-graveyard",
  "version": "0.1.0",
  "description": "Raise the work git lost. Finds dropped commits, stashes, branches and nameless files, and snapshots your work before an agent runs a destructive git command.",
  "type": "module",
  "bin": {
    "git-graveyard": "bin/graveyard.js",
    "graveyard": "bin/graveyard.js"
  },
  "files": [
    "bin",
    "src",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/dhitalkamal/git-graveyard.git" },
  "homepage": "https://github.com/dhitalkamal/git-graveyard#readme",
  "bugs": { "url": "https://github.com/dhitalkamal/git-graveyard/issues" },
  "dependencies": {
    "three": "^0.187.0"
  },
  "keywords": [
    "git",
    "recovery",
    "reflog",
    "undo",
    "reset",
    "stash",
    "ai-agent",
    "kiro"
  ]
}
